# Optional free Hugging Face token: https://huggingface.co/settings/tokens
# Empty uses the smaller shared anonymous GPU allowance.
HUGGINGFACE_TOKEN=

# Required stable secret for signed tickets and encrypted records.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENDER_SIGNING_SECRET=

# Required in production to protect the limited daily GPU allowance.
STUDIO_ACCESS_CODE=

# Optional separate AI provider for conversation and bespoke shot direction.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Vercel: connect a PUBLIC Blob store for records and finished videos.
# Leave empty locally to save in ignored .data/ instead.
BLOB_READ_WRITE_TOKEN=
