# Main video engine: create your own credentials at https://cloud.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Required in production: a private code shared with people allowed to spend generation credits.
STUDIO_ACCESS_CODE=

# Optional separate AI provider for natural conversation and creative planning.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Vercel: connect a PUBLIC Blob store; Vercel adds this automatically.
# Leave empty locally to save videos in .data/ instead.
BLOB_READ_WRITE_TOKEN=

# Recommended stable random secret for generation tickets and encrypted jobs.
# Falls back to HF_API_KEY_SECRET. Rotating it invalidates existing jobs.
RENDER_SIGNING_SECRET=
