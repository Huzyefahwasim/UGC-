# Legacy Wan/LTX jobs only; normal asset assembly does not use this token.
HUGGINGFACE_TOKEN=

# Required stable secret for signed tickets and encrypted records.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RENDER_SIGNING_SECRET=

# Required in production to restrict video creation access.
STUDIO_ACCESS_CODE=

# Gemini handles conversation, captions and bespoke shot direction.
# Create a key at https://aistudio.google.com/apikey (free tier has quotas).
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional legacy provider, only used when AI_PROVIDER=openai.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Vercel: connect a PUBLIC Blob store for records and finished videos.
# Leave empty locally to save in ignored .data/ instead.
BLOB_READ_WRITE_TOKEN=
