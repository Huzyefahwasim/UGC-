OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Vercel: connect a PUBLIC Blob store; Vercel adds this automatically.
# Leave empty locally to save videos in .data/ instead.
BLOB_READ_WRITE_TOKEN=

# Optional separate secret for signed render tickets.
# Otherwise the Blob token is used on Vercel, or a local generated key in dev.
RENDER_SIGNING_SECRET=
